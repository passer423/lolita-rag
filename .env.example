# ===== 微博爬虫 Cookie =====
# 登录 weibo.com 后，在浏览器开发者工具 -> Network -> 任意请求的 Request Headers 复制 cookie
# 不配置也可用 mock 数据跑通 RAG 流程
WEIBO_COOKIE=
# 请求最小间隔（秒）。这是合规与稳定性的底线，不建议调到 1 秒以下
CRAWL_INTERVAL=2.5
CRAWL_TIMEOUT=15
CRAWL_MAX_RETRY=3
CRAWL_PAGES=3
# 需要走代理时填写，例如 http://127.0.0.1:7890
HTTP_PROXY=

# ===== LLM API（兼容 OpenAI 协议）=====
# 推荐 DeepSeek： https://platform.deepseek.com/
# 或 通义千问：    https://dashscope.console.aliyun.com/ (base_url: https://dashscope.aliyuncs.com/compatible-mode/v1)
# 或 智谱 GLM：    https://open.bigmodel.cn/  (base_url: https://open.bigmodel.cn/api/paas/v4)
# 留空也能跑：检索正常，答案退化为「原文摘录」模式
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60
LLM_MAX_TOKENS=1024

# ===== Embedding =====
# 后端：auto（优先 BGE，失败自动降级）/ bge（强制）/ hash（纯本地哈希，零依赖）
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 是否允许联网下载模型。默认 false：只用本地缓存，避免离线时长时间超时
EMBEDDING_ALLOW_DOWNLOAD=false
EMBEDDING_BATCH_SIZE=32

# ===== 检索 =====
# 向量后端：chroma / simple（chroma 不可用时自动降级为 simple）
VECTOR_BACKEND=chroma
CHROMA_COLLECTION=lolita_posts
TOP_K=5
RECALL_K=20
# 融合方式：
#   weighted（默认）——每路按本查询内的最高分归一化再加权，保留「好多少」的信息；
#   rrf            ——只用名次（RRF），对分数尺度不敏感但会把差距压平。
# 小候选集下 RRF 会把「BM25 得 9.17 分」和「只匹配一个常见词得 1.43 分」压成 1/61 与 1/62，
# 导致不相关内容被抬进 top-k（实测问题），所以默认用 weighted。
FUSION_MODE=weighted
RRF_K=60
BM25_WEIGHT=1.0
VECTOR_WEIGHT=1.0
# 向量相似度的绝对下限：低于它的结果直接丢弃，不进入融合。
# 这是让系统能说出「语料里没有」的唯一有效手段——稠密检索永远会返回最近的若干条。
#
# 默认 0.44 由 python scripts/explain_retrieval.py --scan 标定。
#
# ⚠️ 它**不是**「相关与不相关之间的空隙」了：语料涨到 690 条后两者已经重叠
#    （相关最低 0.4602 / 语料外最高 0.5049）。现在它只是「进结果的最低语义门槛」，
#    精度靠另外三道机制提供（内容词要求、生僻词锚定、核心概念缺失即拒答），
#    详见 README「闸门必须对每一路生效」与「检索质量的第二轮修复」。
#
# ⚠️ 换 embedding 模型、或语料规模大幅变化后必须重新标定，不要沿用这个数。
MIN_VECTOR_SCORE=0.44
# BM25 分数的相对下限：低于「本查询最高分 × 该比例」的命中被丢弃。
# BM25 绝对值随语料规模变化（IDF 会涨），所以只能用相对值。
MIN_BM25_RATIO=0.2
# 「生僻词」门槛：查询词在全语料的出现比例 ≤ 该值时算有区分度。
# 查询里存在生僻词时，片段必须命中生僻词（或具备语义支持），
# 否则「裙子」「lo裙」这类出现上百次的词会把无关博文带进结果。
# 取 0.10 的依据：「痛lo」df=29/615(4.7%) 要保住，「裙子」df=98/615(16%) 要剪掉。
DISTINCTIVE_DF_RATIO=0.10

# ===== 切分 =====
# 短于该字数的博文不入库：它只有一个短语，构不成可检索的知识单元，
# 却会在 BM25 里拿到很高的 idf 密度。实测 681 片段里 81 条不足 20 字，
# 剔除后「20 字以内的废话」在返回结果里的占比从 25% 降到 2%，
# 而评测集里所有正确答案都是 69 字以上。
CHUNK_MIN_LEN=18

# ===== 目录与日志 =====
# DATA_DIR 保持留空/注释都行，两种情况都会使用项目下的 data/
# DATA_DIR=
LOG_LEVEL=INFO

# ===== 查询日志 =====
# 每次**真实**检索落一行到 data/logs/queries.jsonl。
#
# 为什么值得开着：eval/qa_real.jsonl 是「读完语料手写」的，拿它做优化等于自己出题
# 自己答题；线上真实查询是唯一不受这层影响的证据来源，也是发现 bad case 的唯一闭环。
#     python scripts/query_log.py            # 概览：拒答率、延迟分位、高频查询
#     python scripts/query_log.py --refused  # 只看拒答（bad case 候选池）
#
# 两条硬约束：写日志失败绝不影响检索；评测与排查脚本直接调 retriever，**不进日志**。
QUERY_LOG_ENABLED=true
# 每行只存前 N 条命中的摘要（chunk_id/作者/分数/召回路径），不存全文，避免日志膨胀。
QUERY_LOG_TOP_HITS=3

# ===== 运行时答案闸门 =====
# 模型答案返回给用户之前先过一遍机器校验（引用越界 / 无引用作答 / 编造数字 /
# 资料为空却硬答），不达标就**降级为原文摘录**——摘录是一字不改的语料原文，
# 因此「模型编造」从「可能返回给用户」变成「不可能返回给用户」。
#
# ⚠️ 它只挡机器可判定的那几类；语义层面的不忠实（把资料的 A 说成 B、资料里有却说没有）
# 抓不到，那要 LLM-as-judge。别把「通过校验」当成「一定忠实」。
ANSWER_VERIFY_ENABLED=true

# ===== 每日定时更新（配合 scripts/register_task.ps1）=====
# 每晚重扫这些关键词的「最前面几页」：微博搜索的新内容在顶部，
# 靠博文 id 去重，只有真正的新博文会被切分与编码。
DAILY_KEYWORDS=Lolita,lo裙
DAILY_PAGES=2
# 锁超过该时长视为陈旧（上一次进程被强杀时锁文件会残留），允许被接管
DAILY_LOCK_STALE_HOURS=6
